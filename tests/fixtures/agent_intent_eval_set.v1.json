{
  "schema_version": 1,
  "eval_set_id": "agent-intent-eval-set-v1",
  "purpose": "固定问法 -> 预期本地路由结果的回归基线（docs/prd-ontology-agent-pnl.md 第十一节要求的路由基线）。",
  "scope": "只覆盖 backend/app/agent/runtime/local_request_resolution.py 的本地意图路由判定，不覆盖下游取数、口径与展示。",
  "case_schema": {
    "case_id": "唯一用例标识",
    "question": "用户问法原文",
    "context": "可选，写入 AgentQueryRequest.context",
    "filters": "可选，写入 AgentQueryRequest.filters",
    "page_context": "可选，写入 AgentQueryRequest.page_context",
    "expected.route": "local 或 provider",
    "expected.intent": "本地路由命中的 intent；provider 或澄清用例为 null",
    "expected.clarification_reason": "澄清用例的 semantic_reason_code；其余为 null",
    "note": "该用例锁定的具体行为"
  },
  "cases": [
