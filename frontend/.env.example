# 复制为 .env.development 或 .env.local 并按需修改。
# 默认仓库约定：前端 dev 5888，后端 7888；开发时勿填 VITE_API_BASE_URL 以使用 Vite 代理。
VITE_DATA_SOURCE=real
VITE_API_BASE_URL=
# MOSS Chat 默认关闭；开发或生产发布时显式设为 true，修改后需重启开发服务或重新构建。
# 前端入口开关不改变后端权限与运行开关；Agent Lab 仍仅在开发模式开放。
VITE_MOSS_AGENT_FRONTEND_ENABLED=false
VITE_JOB_POLL_INTERVAL_MS=250
VITE_JOB_POLL_MAX_ATTEMPTS=40
