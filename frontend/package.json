{
  "name": "moss-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:source": "node ../scripts/dev-frontend-source.mjs",
    "build": "tsc -b && vite build && npm run guard:candidate-financial-indicators",
    "build:fast": "vite build && npm run guard:candidate-financial-indicators",
    "preview": "vite preview",
    "debt:audit": "node ../scripts/run_frontend_debt_audits.mjs",
    "debt:audit:frontend": "node ../scripts/run_frontend_debt_audits.mjs --scope frontend",
    "guard:home-startup": "node scripts/verifyHomeStartupBundle.mjs",
    "guard:market-data-startup": "node scripts/verifyMarketDataStartupBundle.mjs",
    "guard:balance-startup": "node scripts/verifyBalanceAnalysisStartupRuntime.mjs",
    "guard:balance-startup:runtime": "node scripts/verifyBalanceAnalysisStartupRuntime.mjs --build",
    "guard:candidate-financial-indicators": "node scripts/verifyCandidateFinancialIndicatorBundle.mjs",
    "guard:home-startup:runtime": "npm run build && node scripts/verifyHomeStartupRuntime.mjs",
    "guard:home-startup:live": "node scripts/sampleHomeStartupLive.mjs",
    "test:home-runtime-acceptance": "node --test scripts/homeRuntimeAcceptance.test.mjs",
    "profile:home-snapshot:live": "node scripts/profileHomeSnapshotLive.mjs",
    "style:audit": "node ../scripts/audit_frontend_style_diff.mjs",
    "style:inventory": "node ../scripts/audit_frontend_style_inventory.mjs",
    "lint": "eslint .",
    "lint:openapi": "node -e \"if(!require('fs').existsSync('../.codex-tmp/openapi.json')){console.error('missing ../.codex-tmp/openapi.json - run from repo root (repo venv): python scripts/api_contract_check.py export-openapi --surface default --output .codex-tmp/openapi.json');process.exit(1)}\" && node scripts/lintOpenApi.mjs ../.codex-tmp/openapi.json -r ../.spectral.yaml",
    "test": "node scripts/vitest-safe.mjs run",
    "test:a11y-smoke": "playwright test -c playwright.config.mjs",
    "test:a11y-smoke:headed": "playwright test -c playwright.config.mjs --headed",
    "test:watch": "node scripts/vitest-safe.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@ant-design/icons": "^5.0.0",
    "@assistant-ui/react": "0.15.14",
    "@tanstack/react-query": "^5.0.0",
    "ag-grid-community": "^35.2.1",
    "ag-grid-react": "^35.2.1",
    "antd": "^5.0.0",
    "decimal.js": "10.6.0",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-markdown": "10.1.0",
    "react-router-dom": "^7.18.2",
    "remark-gfm": "4.0.1",
    "write-excel-file": "^4.0.6",
    "dayjs": "1.11.21"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "@stoplight/spectral-core": "1.23.1",
    "@stoplight/spectral-parsers": "1.0.5",
    "@stoplight/spectral-ref-resolver": "1.0.5",
    "@stoplight/spectral-ruleset-bundler": "1.7.0",
    "@stoplight/spectral-runtime": "1.1.6",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.0.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.11"
  }
}
