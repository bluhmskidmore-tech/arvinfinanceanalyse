{
  "name": "moss-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run guard:candidate-financial-indicators",
    "build:fast": "vite build && npm run guard:candidate-financial-indicators",
    "preview": "vite preview",
    "debt:audit": "node ../scripts/audit_frontend_debt.mjs && node ../scripts/audit_visual_tokens.mjs",
    "guard:home-startup": "node scripts/verifyHomeStartupBundle.mjs",
    "guard:balance-startup": "node scripts/verifyBalanceAnalysisStartupRuntime.mjs",
    "guard:balance-startup:runtime": "node scripts/verifyBalanceAnalysisStartupRuntime.mjs --build",
    "guard:candidate-financial-indicators": "node scripts/verifyCandidateFinancialIndicatorBundle.mjs",
    "guard:home-startup:runtime": "npm run build && node scripts/verifyHomeStartupRuntime.mjs",
    "guard:home-startup:live": "node scripts/sampleHomeStartupLive.mjs",
    "profile:home-snapshot:live": "node scripts/profileHomeSnapshotLive.mjs",
    "style:audit": "node ../scripts/audit_frontend_style_diff.mjs",
    "style:inventory": "node ../scripts/audit_frontend_style_inventory.mjs",
    "lint": "eslint .",
    "lint:openapi": "spectral lint ../.codex-tmp/openapi.json -r ../.spectral.yaml",
    "test": "node scripts/vitest-safe.mjs run",
    "test:a11y-smoke": "playwright test -c playwright.config.mjs",
    "test:a11y-smoke:headed": "playwright test -c playwright.config.mjs --headed",
    "test:watch": "node scripts/vitest-safe.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@ant-design/icons": "^5.0.0",
    "@heroui/styles": "^3.2.1",
    "@tanstack/react-query": "^5.0.0",
    "ag-grid-community": "^35.2.1",
    "ag-grid-react": "^35.2.1",
    "antd": "^5.0.0",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "write-excel-file": "^4.0.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "@stoplight/spectral-cli": "^6.15.1",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "jsdom": "^25.0.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.0.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.6"
  }
}
