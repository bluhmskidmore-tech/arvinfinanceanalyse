{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MOSS Ontology v1",
  "type": "object",
  "required": ["version", "generated_from", "entities", "relationships"],
  "properties": {
    "version": { "const": 1 },
    "generated_from": {
      "type": "array",
      "items": { "type": "string" }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "entity_id",
          "entity_type",
          "name",
          "aliases",
          "business_definition",
          "authority",
          "status"
        ],
        "properties": {
          "entity_id": { "type": "string" },
          "entity_type": {
            "enum": [
              "Page",
              "Metric",
              "BusinessConcept",
              "DataField",
              "CalculationRule",
              "SourceSurface",
              "ResultKind",
              "Table",
              "GoldenSample",
              "TestAnchor"
            ]
          },
          "name": { "type": "string" },
          "aliases": {
            "type": "array",
            "items": { "type": "string" }
          },
          "business_definition": { "type": "string" },
          "unit": { "type": ["string", "null"] },
          "basis": { "type": ["string", "null"] },
          "precision": { "type": ["integer", "null"] },
          "time_semantics": { "type": ["string", "null"] },
          "null_semantics": { "type": ["string", "null"] },
          "fallback_allowed": { "type": ["boolean", "null"] },
          "authority": {
            "type": "array",
            "items": { "type": "string" }
          },
          "source_fields": {
            "type": "array",
            "items": { "type": "string" }
          },
          "calculation_rules": {
            "type": "array",
            "items": { "type": "string" }
          },
          "result_meta_requirements": {
            "type": "array",
            "items": { "type": "string" }
          },
          "tests": {
            "type": "array",
            "items": { "type": "string" }
          },
          "golden_samples": {
            "type": "array",
            "items": { "type": "string" }
          },
          "status": {
            "enum": ["approved", "gap", "candidate", "deprecated"]
          }
        },
        "additionalProperties": false
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "type", "target"],
        "properties": {
          "source": { "type": "string" },
          "type": {
            "enum": [
              "page_displays_metric",
              "metric_governed_by_rule",
              "metric_bound_to_golden_sample",
              "metric_protected_by_test",
              "result_kind_requires_source_surface",
              "table_supports_metric"
            ]
          },
          "target": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
