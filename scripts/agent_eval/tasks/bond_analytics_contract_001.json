  "gate_probe_gaps": {
    "page_loads": "Needs a bond-analysis scoped Playwright spec; BondAnalyticsView.test.tsx is a jsdom component test and test:a11y-smoke is site-wide, so neither measures a real /bond-analysis page load.",
    "no_console_errors": "Same as page_loads; requires a scoped browser spec that fails on console errors for /bond-analysis."
  }
