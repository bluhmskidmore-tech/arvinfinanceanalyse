    "tests/test_no_finance_logic_in_frontend.py",
    "frontend/src/test/BondAnalyticsUnitContract.test.tsx",
    "frontend/src/test/bondAnalyticsFormatters.test.ts",
    "frontend/src/test/BondAnalyticsHomeCalculations.test.ts",
