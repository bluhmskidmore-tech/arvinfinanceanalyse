MOSS_ENVIRONMENT=development
MOSS_POSTGRES_DSN=postgresql://moss:moss@localhost:5432/moss
# 若为空，回退到 MOSS_POSTGRES_DSN
# MOSS_GOVERNANCE_SQL_DSN=
MOSS_REDIS_DSN=redis://localhost:6379/0
MOSS_DUCKDB_PATH=data/moss.duckdb
MOSS_GOVERNANCE_PATH=data/governance
# MOSS_DATA_INPUT_ROOT=
# MOSS_GOVERNANCE_BACKEND=jsonl
# MOSS_SOURCE_PREVIEW_GOVERNANCE_BACKEND=jsonl
# MOSS_JOB_STATE_DSN=
MOSS_OBJECT_STORE_MODE=local
MOSS_LOCAL_ARCHIVE_PATH=data/archive
MOSS_MINIO_ENDPOINT=localhost:9000
MOSS_MINIO_ACCESS_KEY=minioadmin
MOSS_MINIO_SECRET_KEY=minioadmin
MOSS_MINIO_BUCKET=moss-artifacts
MOSS_CHOICE_EMQUANT_PARENT=
MOSS_CHOICE_START_OPTIONS=
MOSS_CHOICE_REQUEST_OPTIONS=
MOSS_CHOICE_USERNAME=
MOSS_CHOICE_PASSWORD=
# 兼容旧式/进程注入：无 MOSS_ 前缀时仍可由 choice_runtime 合并进 start_options（与 YAML / MOSS_* 同源优先级见 load_settings 顺序）
CHOICE_USERNAME=
CHOICE_PASSWORD=
MOSS_CHOICE_MACRO_SERIES_JSON=[]
MOSS_CHOICE_MACRO_CATALOG_FILE=config/choice_macro_catalog.json
# MOSS_CHOICE_MACRO_URL=
MOSS_CHOICE_MACRO_COMMANDS_FILE=
# MOSS_CHOICE_STOCK_CATALOG_FILE=config/choice_stock_catalog.json
MOSS_CHOICE_NEWS_TOPICS_FILE=config/choice_news_topics.json
# MOSS_CHOICE_TIMEOUT_SECONDS=10.0
# MOSS_TUSHARE_TOKEN=<your-tushare-token>
# MOSS_TUSHARE_NEWS_SRC=sina
MOSS_FX_OFFICIAL_SOURCE_PATH=
MOSS_FX_MID_CSV_PATH=
# MOSS_PRODUCT_CATEGORY_SOURCE_DIR=
# MOSS_FTP_RATE_PCT=1.75
# MOSS_PNL_BY_BUSINESS_YTD_PREFER_FORMAL_FACTS=true
# MOSS_HOME_SNAPSHOT_PREWARM_ENABLED=true
# MOSS_HOME_INCOME_TREND_PREWARM_ENABLED=true
# MOSS_CORS_ORIGINS=http://localhost:5888,http://127.0.0.1:5888
# OpenTelemetry（可选，见 docs/OBSERVABILITY.md）
# MOSS_OTEL_ENABLED=
# MOSS_OTEL_EXPORTER=console
# MOSS_OTEL_SERVICE_NAME=moss-backend
# Agent MVP（生产默认关闭，见 docs/AGENT_MVP_RUNBOOK.md）
# MOSS_AGENT_ENABLED=false
# MOSS_AGENT_DEV_SCOPE_BYPASS=false
# MOSS_AGENT_PROVIDER=local
# MOSS_AGENT_HERMES_COMMAND=wsl.exe
# MOSS_AGENT_HERMES_WSL_DISTRO=HermesUbuntu
# MOSS_AGENT_HERMES_HOME=
# MOSS_AGENT_HERMES_TRANSPORT=cli
# MOSS_AGENT_HERMES_BRIDGE_URL=http://127.0.0.1:7891
# MOSS_AGENT_HERMES_MODEL=
# MOSS_AGENT_HERMES_TOOLSETS=
# MOSS_AGENT_HERMES_MAX_TURNS=20
# MOSS_AGENT_HERMES_TIMEOUT_SECONDS=180.0
# MOSS_AGENT_DEXTER_COMMAND=dexter
# MOSS_AGENT_DEXTER_TRANSPORT=cli
# MOSS_AGENT_DEXTER_BRIDGE_URL=http://127.0.0.1:7892
# MOSS_AGENT_DEXTER_MODEL=
# MOSS_AGENT_DEXTER_TOOLSETS=
# MOSS_AGENT_DEXTER_TIMEOUT_SECONDS=180.0
CHOICE_EMQUANT_PARENT=
CHOICE_MACRO_CHOICE_START_OPTIONS=
CHOICE_MACRO_CHOICE_REQUEST_OPTIONS=
VITE_DATA_SOURCE=mock
# 本地约定：后端 dev-api.ps1 使用 7888；前端 vite 5888。开发时前端 .env 可留空 VITE_API_BASE_URL 以走 Vite 代理。
VITE_API_BASE_URL=http://127.0.0.1:7888
VITE_JOB_POLL_INTERVAL_MS=250
VITE_JOB_POLL_MAX_ATTEMPTS=40
# Formal PnL 物化开关（默认启用，环境变量可关闭）
MOSS_FORMAL_PNL_ENABLED=true
MOSS_FORMAL_PNL_SCOPE_JSON=["*"]
# 市场工作台首页：进程内 TTL 缓存（秒，0=关闭）与启动预热（1=开启）
MOSS_MARKET_HOME_CACHE_TTL_SECONDS=300
MOSS_MARKET_HOME_PREWARM_ENABLED=1
# Google Stitch UI 设计 MCP（https://stitch.google.com/ → API Key）
STITCH_API_KEY=
